[Unit]
Description=ToteBot delayed-race rolling observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/botlab/totebot/scripts
Environment=PYTHONPATH=/opt/betfair
Environment=BETFAIR_SECRETS_FILE=/opt/betfair/secrets.env
EnvironmentFile=-%h/.config/totebot/betfair-services.env
ExecStartPre=/usr/bin/python3 %h/botlab/totebot/scripts/tb_betfair_preflight.py --role observer
ExecStart=/usr/bin/python3 %h/botlab/totebot/scripts/tb_race_observer.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
